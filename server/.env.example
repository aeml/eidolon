# Copy to .env and keep existing non-Mongo values when merging.

# Host-side upstream port for Nginx proxy target.
APP_HOST_PORT=18082

# Mongo root credentials used by Mongo container initialization.
MONGO_INITDB_ROOT_USERNAME=eidolon_root
MONGO_INITDB_ROOT_PASSWORD=change_me

# App database target.
MONGO_DB_NAME=eidolon
MONGO_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:27017/${MONGO_DB_NAME}?authSource=admin

# App logging flags (mapped to main.go flags).
LOG_FILE=logs/server.log
LOG_STDOUT=true
LOG_HTTP_ERRORS=false
SUSPICIOUS_LOG_FILE=logs/junk.log
SUSPICIOUS_STDOUT=false

# Release-QA chat commands (/level, fixed /qa-waypoint destinations, and one
# guaranteed normal /qa-loot-next roll) require this authenticated allowlist.
EIDOLON_QA_USERNAMES=
