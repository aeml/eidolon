# Copy to .env and keep existing non-Mongo values when merging.

# Host-side upstream port for Nginx proxy target.
APP_HOST_PORT=18082

# Prepared 1.71: bound simultaneous credential queries/hashes (whole number 1-32).
# Busy requests receive retry feedback; do not raise without measured headroom.
EIDOLON_AUTH_MAX_CONCURRENT=4

# Prepared 1.72: per-process WebSocket transport ceiling (whole number 1-4096).
# This is a resource bound, not a measured player-capacity claim.
EIDOLON_WS_MAX_CONNECTIONS=512

# Mongo root credentials used by Mongo container initialization.
MONGO_INITDB_ROOT_USERNAME=eidolon_root
MONGO_INITDB_ROOT_PASSWORD=change_me

# App database target.
MONGO_DB_NAME=eidolon
MONGO_URI=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@mongo:27017/${MONGO_DB_NAME}?authSource=admin

# App logging flags (mapped to main.go flags).
LOG_FILE=logs/server.log
LOG_STDOUT=true
LOG_HTTP_ERRORS=false
SUSPICIOUS_LOG_FILE=logs/junk.log
SUSPICIOUS_STDOUT=false

# Release-QA chat commands (/level, fixed /qa-waypoint destinations, and one
# guaranteed normal /qa-loot-next roll) require this authenticated allowlist.
EIDOLON_QA_USERNAMES=

# Prepared 1.71: bootstrap is disabled by default. Temporarily configure only
# an existing operator-owned account, verify ownership before enabling, then
# remove its exact username after /relevel persists the durable admin role.
# Public registration reserves configured names, including case variants.
# This is separate from release-QA access; existing durable roles remain valid.
EIDOLON_ADMIN_BOOTSTRAP_USERNAMES=

# Structured administration/session history; whole days, minimum 7, maximum 365.
EIDOLON_ADMIN_AUDIT_RETENTION_DAYS=90

# Email recovery: Postmark server token, verified sender mailbox
# (optional display name), and transactional stream (empty defaults to outbound).
# Leave blank until configured; never commit real tokens or copy them into chat.
# Read at startup. Use a verified Postmark sender and transactional stream.
# Invalid partial configuration prevents startup; all three blank disables mail.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=
# Reserved for separately approved operational notifications. Recovery links
# must never be copied/BCC'd to administrators.
ADMIN_NOTIFICATION_EMAILS=
