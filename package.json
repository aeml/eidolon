{
  "name": "eidolon-tests",
  "version": "1.80.5",
  "description": "Eidolon browser game client, validation, and release tooling",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "prepare:client": "node scripts/build/prepare-client.mjs",
    "check:content": "node scripts/content/check-content.mjs",
    "generate:cosmetics": "node scripts/content/generate-cosmetics.mjs",
    "generate:equipment": "node scripts/content/generate-authored-equipment.mjs",
    "postinstall": "npm run prepare:client",
    "serve": "node scripts/dev/serve-static.mjs",
    "test:e2e:crystal-art": "node scripts/qa/run-e2e-suite.mjs crystal-art",
    "test:e2e:journal": "node scripts/qa/run-e2e-suite.mjs journal",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runTestsByPath tests/unit/core/world/CollisionManager.test.js tests/unit/core/gameplay/equipment/ItemSystem.test.js",
    "test:e2e": "playwright test",
    "test:e2e:privacy": "node scripts/qa/run-e2e-suite.mjs privacy",
    "test:e2e:nameplates": "node scripts/qa/run-e2e-suite.mjs nameplates",
    "test:e2e:resource-hud": "node scripts/qa/run-e2e-suite.mjs resource-hud",
    "test:e2e:interface": "node scripts/qa/run-e2e-suite.mjs interface",
    "test:e2e:anonymous": "node scripts/qa/run-e2e-suite.mjs anonymous",
    "test:e2e:authenticated": "node scripts/qa/run-e2e-suite.mjs authenticated",
    "test:e2e:isolated": "bash scripts/qa/run-isolated-character-qa.sh",
    "test:e2e:rest-render": "bash scripts/qa/run-rest-render-qa.sh",
    "test:e2e:celebration": "node scripts/qa/run-e2e-suite.mjs celebration",
    "test:e2e:authored-equipment": "node scripts/qa/run-e2e-suite.mjs authored-equipment",
    "test:e2e:live-animations": "bash scripts/qa/run-live-animation-qa.sh",
    "test:e2e:movement": "node scripts/qa/run-e2e-suite.mjs movement",
    "test:e2e:visual-load": "node scripts/qa/run-e2e-suite.mjs visual-load",
    "test:e2e:multiplayer": "node scripts/qa/run-e2e-suite.mjs multiplayer",
    "test:e2e:animations": "node scripts/qa/run-e2e-suite.mjs animations",
    "benchmark:client": "node scripts/benchmarks/benchmark-client.mjs",
    "audit:talent-consumers": "node scripts/validation/audit-talent-consumers.mjs",
    "verify:browser-gpu": "node scripts/qa/verify-browser-gpu.mjs",
    "docs:animations": "node scripts/content/generate-animation-coverage.mjs",
    "lint": "eslint src tests scripts playwright.config.js --max-warnings=0",
    "generate:gameplay-geometry": "node scripts/content/generate-gameplay-geometry-precomputed.mjs",
    "check:layout": "node scripts/validation/check-repository-layout.mjs"
  },
  "dependencies": {
    "three": "0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.61.1",
    "eslint": "^9.39.1",
    "esbuild": "0.28.2",
    "globals": "^15.15.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "meshoptimizer": "1.2.0",
    "protobufjs": "8.7.1",
    "protobufjs-cli": "2.6.1",
    "sharp": "0.35.5"
  },
  "overrides": {
    "test-exclude": "^7.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "markdown-it": "14.3.3",
    "glob@>=9.0.0 <14.0.2": "14.0.6",
    "minimatch@>=7.0.0 <11.0.1": "11.0.8"
  }
}
