{
  "name": "eidolon-tests",
  "version": "1.0.0",
  "description": "Unit tests for Eidolon",
  "type": "module",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:smoke": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runTestsByPath tests/CollisionManager.test.js tests/ItemSystem.test.js"
  },

  "dependencies": {
    "three": "^0.181.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "protobufjs": "^7.5.4",
    "protobufjs-cli": "^1.1.3"
  },
  "overrides": {
    "test-exclude": "^7.0.0"
  }
}
